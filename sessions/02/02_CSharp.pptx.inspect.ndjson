{"kind":"textbox","id":"sh/7y9o3u14","slide":13,"name":"fighter-one","text":"using System;\nusing System.Collections.Generic;\n\nclass Fighter\n{\n    public string Name;\n    public int Hp;\n    public int MaxHp;\n    public int Attack;\n    public List<string> Items = new() { \"Potion\" };\n\n    public Fighter(string name, int hp, int attack)\n    {\n        Name = name;\n        Hp = hp;\n        MaxHp = hp;\n        Attack = attack;\n    }\n\n    public bool IsDead()\n    {\n        return Hp <= 0;\n    }\n}","textPreview":"using System; | using System.Collections.Generic; |  | class Fighter | { |     public string Name; |     public int Hp; |     public int ...","textChars":416,"textLines":24,"bbox":[62,142,820,525]}
