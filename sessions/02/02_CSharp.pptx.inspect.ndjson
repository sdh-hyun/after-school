{"kind":"textbox","id":"sh/29cnqpcr","slide":16,"name":"main-two","text":"            else if (input == \"2\")\n            {\n                bool used = player.UsePotion();\n                if (!used) Console.WriteLine(\"물약이 없습니다.\");\n            }\n            else\n            {\n                Console.WriteLine(\"다시 입력하세요.\");\n                continue;\n            }\n\n            if (!monster.IsDead())\n            {\n                int damage = monster.MakeDamage(random);\n                player.TakeDamage(damage);\n                Console.WriteLine($\"몬스터의 {damage} 피해\");\n            }\n        }\n\n        if (monster.IsDead()) Console.WriteLine(\"승리\");\n        else Console.WriteLine(\"게임 오버\");\n    }\n}","textPreview":"else if (input == \"2\") |             { |                 bool used = player.UsePotion(); |                 if (!used) Console.WriteLine(\"...","textChars":623,"textLines":23,"bbox":[62,140,830,508]}
