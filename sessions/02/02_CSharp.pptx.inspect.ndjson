{"kind":"textbox","id":"sh/mp0nqlov","slide":15,"name":"main-one","text":"class Program\n{\n    static void Main()\n    {\n        Random random = new();\n        Fighter player = new(\"Player\", 30, 8);\n        Fighter monster = new(\"Slime\", 25, 6);\n\n        while (!player.IsDead() && !monster.IsDead())\n        {\n            Console.WriteLine($\"플레이어: {player.Hp}\");\n            Console.WriteLine($\"몬스터: {monster.Hp}\");\n            Console.Write(\"1. 공격  2. 회복: \");\n\n            string input = Console.ReadLine();\n\n            if (input == \"1\")\n            {\n                int damage = player.MakeDamage(random);\n                monster.TakeDamage(damage);\n                Console.WriteLine($\"{damage} 피해\");\n            }","textPreview":"class Program | { |     static void Main() |     { |         Random random = new(); |         Fighter player = new(\"Player\", 30, 8); |   ...","textChars":643,"textLines":22,"bbox":[62,140,830,508]}
